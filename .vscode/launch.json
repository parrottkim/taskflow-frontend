{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "dev",
      "request": "launch",
      "type": "dart",
      "flutterMode": "debug",
      "args": [
        "--dart-define=ENVIRONMENT=dev",
        "--flavor",
        "dev"
      ]
    },
    {
      "name": "local-web",
      "request": "launch",
      "type": "dart",
      "flutterMode": "debug",
      "args": [
        "--web-port=8080",
        "--web-hostname=192.168.150.87",
        "--web-tls-cert-path=.cert/localhost.pem",
        "--web-tls-cert-key-path=.cert/localhost-key.pem",
        "--dart-define=ENVIRONMENT=local",
      ]
    },
    {
      "name": "dev-web",
      "request": "launch",
      "type": "dart",
      "flutterMode": "debug",
      "args": [
        "--web-port=8080",
        "--dart-define=ENVIRONMENT=dev",
        "--web-browser-flag",
        "--disable-web-security",
      ]
    },
    {
      "name": "prod-web",
      "request": "launch",
      "type": "dart",
      "flutterMode": "debug",
      "args": [
        "--web-port=8080",
        "--dart-define=ENVIRONMENT=prod",
        "--web-browser-flag",
        "--disable-web-security",
      ]
    },
  ]
}
